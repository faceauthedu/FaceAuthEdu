# Copia este archivo como ".env" (sin ".example") y completa tus datos.
# No subas nunca el archivo ".env" real a GitHub (ya está en .gitignore).

# Cuenta de Gmail desde la que se enviarán los correos automáticos del formulario
GMAIL_USER=faceauthedu@gmail.com

# "Contraseña de aplicación" de Gmail (NO tu contraseña normal).
# Se genera en: https://myaccount.google.com/apppasswords
# (requiere tener la verificación en dos pasos activada en esa cuenta)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
